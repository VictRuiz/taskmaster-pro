{
  "name": "taskmaster-pro",
  "version": "1.0.0",
  "description": "Aplicación profesional de gestión de tareas construida con Vanilla JavaScript, Webpack y TailwindCSS",
  "main": "index.js",
  "homepage": "https://tuusuario.github.io/taskmaster-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuusuario/taskmaster-pro.git"
  },
  "bugs": {
    "url": "https://github.com/tuusuario/taskmaster-pro/issues"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack serve --mode development --open",
    "build": "NODE_ENV=production webpack --mode production",
    "deploy": "npm run build && gh-pages -d dist",
    "dev": "NODE_ENV=development webpack --mode development --watch"
  },
  "keywords": [
    "todo",
    "tasks",
    "productivity",
    "task-manager",
    "project-management",
    "vanilla-js",
    "webpack",
    "tailwindcss"
  ],
  "author": "Victor Ruiz",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^2.30.0",
    "feather-icons": "^4.29.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/plugin-transform-class-properties": "^7.22.5",
    "@babel/plugin-transform-object-rest-spread": "^7.22.5",
    "@babel/plugin-transform-private-methods": "^7.22.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.23.2",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "core-js": "^3.46.0",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
